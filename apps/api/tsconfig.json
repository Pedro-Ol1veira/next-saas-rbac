{
    "extends": "@saas/tsconfig/node.json",
    "include": ["src/**/*", "@types/*", "prisma/generated"],
    "compilerOptions": {
        "paths": {
            "@/*": ["./src/*"]
        },
        "module": "ESNext",
        "moduleResolution": "Bundler",
        "types": [
            "node",
            "vitest/globals"
        ]
    }
}